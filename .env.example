# ダミー値のみ。実際の値は .env(Git管理外)に設定する。
# 注意: EXPO_PUBLIC_ で始まる変数はアプリに埋め込まれ公開される。秘密情報を入れないこと。

# --- apps/mobile (公開される値のみ) ---
# 解析APIのベースURL(Phase 3 で使用)。Androidエミュレータからホストへは 10.0.2.2
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8787

# --- apps/api (サーバー側のみ。秘密情報はここ) ---
# Anthropic Console で発行したキーを apps/api/.env に設定する。チャットやコミットに貼らない。
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# 既定は Sonnet 5.5。Task 13 の実測の後に確定する。
ANTHROPIC_MODEL=claude-sonnet-5-5
# 思考の深さ(low | medium | high)。検出は medium を初期値にする。
ANTHROPIC_EFFORT=medium
PORT=8787
# IP あたり 1 分間の解析回数(簡易。本格対応は Phase 6)
RATE_LIMIT_PER_MINUTE=20
# 費用の概算用。USD / 100 万トークン。未設定なら概算を出さない(料金表はソースに固定しない)。
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

# --- Phase 4: 商品特定(サーバーのみ) ---
SERPAPI_API_KEY=REPLACE_ME
# SerpApi の月間検索の上限(無料枠は 250)。到達すると SerpApi を止める。80% でログに警告。
SERPAPI_MONTHLY_LIMIT=200
# 1 検索あたりの概算 USD(プランの月額 ÷ 検索数)。未設定なら費用に含めない。
SERPAPI_COST_PER_SEARCH_USD=
# 楽天ウェブサービス(applicationId と accessKey の両方が必要)
RAKUTEN_APPLICATION_ID=REPLACE_ME
RAKUTEN_ACCESS_KEY=REPLACE_ME
# 楽天アフィリエイト ID。未設定ならリンクは収益化されない。
RAKUTEN_AFFILIATE_ID=
# 検索結果のメモリキャッシュ(秒)
SEARCH_CACHE_TTL_SECONDS=3600
# 1 日あたりの商品特定の回数(インストール ID あたり。IP は 3 倍)
IDENTIFY_DAILY_LIMIT=30
# 使用量(数値のみ)の保存先
USAGE_FILE=data/usage.json
