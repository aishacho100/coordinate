# ダミー値のみ。実際の値は .env(Git管理外)に設定する。
# 注意: EXPO_PUBLIC_ で始まる変数はアプリに埋め込まれ公開される。秘密情報を入れないこと。

# --- apps/mobile (公開される値のみ) ---
# 解析APIのベースURL(Phase 3 で使用)。Androidエミュレータからホストへは 10.0.2.2
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8787

# --- apps/api (サーバー側のみ。秘密情報はここ) ---
# Phase 3 で使用。Anthropic Console で発行したキーを apps/api/.env に設定する。
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
